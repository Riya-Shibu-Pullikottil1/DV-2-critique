{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 360,
  "height": 230,

  "title": {
  "text": "Malaysia's Death Rate Has Been Rising",
  "fontSize": 16
},

  "data": {
    "url": "data/death.csv",
    "format": {
      "type": "csv"
    }
  },

  "mark": {
    "type": "line",
    "point": true,
    "color": "#c0392b"
  },

  "encoding": {
    "x": {
  "field": "date",
  "type": "temporal",
  "timeUnit": "year",
  "title": "Year",
  "axis": {
    "format": "%Y",
    "tickCount": 6,
    "labelAngle": 0
  }
},

    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": "Death Rate per 1,000 population",
      "scale": {
        "zero": false
      }
    },

    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "timeUnit": "year",
        "title": "Year"
      },
      {
        "field": "abs",
        "type": "quantitative",
        "title": "Number of Deaths"
      },
      {
        "field": "rate",
        "type": "quantitative",
        "title": "Death Rate"
      }
    ]
  }
}