{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 620,
  "height": 520,

  "title": {
    "text": "Death Composition Has Shifted Across Ethnic Groups",
    "subtitle": "Share of deaths by ethnicity, Malaysia, selected years",
    "anchor": "middle",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "subtitleColor": "#8db600"
  },

  "layer": [
    {
      "data": {
        "url": "data/death_radar_grid.csv",
        "format": {"type": "csv"}
      },
      "mark": {
        "type": "line",
        "color": "#ddd2c4",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "detail": {"field": "ring", "type": "nominal"},
        "order": {"field": "order", "type": "quantitative"}
      }
    },
    {
      "data": {
        "url": "data/death_radar_axes.csv",
        "format": {"type": "csv"}
      },
      "mark": {
        "type": "rule",
        "color": "#ddd2c4",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "url": "data/death_radar_axes.csv",
        "format": {"type": "csv"}
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#333"
      },
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "y": {"field": "label_y", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "url": "data/death_ethnicity_radar.csv",
        "format": {"type": "csv"}
      },
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "interpolate": "linear"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "color": {
          "field": "year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "range": ["#2c7fb8", "#f28e2b", "#59a14f", "#a23b16"]
          }
        },
        "detail": {"field": "year", "type": "nominal"},
        "order": {"field": "order", "type": "quantitative"}
      }
    },
    {
      "data": {
        "url": "data/death_ethnicity_radar.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {"filter": "datum.order < 6"}
      ],
      "mark": {
        "type": "circle",
        "size": 70
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [-1.32, 1.32]}},
        "color": {
          "field": "year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "range": ["#2c7fb8", "#f28e2b", "#59a14f", "#a23b16"]
          }
        },
        "tooltip": [
          {"field": "year", "type": "nominal", "title": "Year"},
          {"field": "ethnicity", "type": "nominal", "title": "Ethnicity"},
          {"field": "abs", "type": "quantitative", "title": "Deaths"},
          {"field": "share", "type": "quantitative", "title": "Share of deaths (%)", "format": ".1f"}
        ]
      }
    }
  ],

  "config": {
    "view": {"stroke": null},
    "legend": {
      "orient": "bottom",
      "titleFontSize": 13,
      "labelFontSize": 12
    }
  }
}